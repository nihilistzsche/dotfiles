source /usr/share/zsh/share/antigen.zsh

unset PS1

antigen use oh-my-zsh
antigen bundle git
antigen bundle ruby
antigen bundle gem
antigen bundle rails
antigen bundle python
antigen bundle rake
antigen bundle rvm
antigen bundle svn
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-history-substring-search
antigen bundle zsh-users/zsh-autosuggestions
antigen bundle sudo
antigen bundle git-extras
antigen bundle l4u/zsh-output-highlighting
antigen bundle MichaelAquilina/zsh-auto-notify
antigen theme spaceship-prompt/spaceship-prompt

antigen apply

#setopt no_bare_glob_qual
setopt extended_glob
setopt inc_append_history
setopt share_history

export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

unset GREP_OPTIONS
alias grep="grep --color=auto"
alias sudo="sudo -E "
alias ls="ls --color=auto"
alias cat="bat -pp"
function chpwd() {
  ls --color
}

export EDITOR='nvim'
alias vim="nvim"
export MAKEFLAGS="-j5"

export PATH="$HOME/.local/bin:/usr/share/rvm/bin:/usr/local/bin:$HOME/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/X11/bin:$PATH"
export PATH="$HOME/.dotnet/tools:$PATH"

eval $(thefuck --alias)

for file in /etc/zsh/*.zsh(N); do
  source "$file"
done

fortune | cowsay | lolcat

{{- if eq .chezmoi.hostname "spiderman" }}
# Only run if a display exists AND we are NOT connected via SSH
if [[ ( -n "$DISPLAY" || -n "$WAYLAND_DISPLAY" ) && -z "$SSH_CONNECTION" && -z "$SSH_CLIENT" ]]; then

  if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
      # Unset for Wayland to let native apps use the Wayland text protocol
      unset GTK_IM_MODULE
      unset QT_IM_MODULE
  else
      # Fallback for X11 sessions
      export GTK_IM_MODULE=fcitx
      export QT_IM_MODULE=fcitx
  fi

else
  # Clean up everything on headless hosts and SSH sessions
  unset GTK_IM_MODULE
  unset QT_IM_MODULE
fi
{{- end }}
