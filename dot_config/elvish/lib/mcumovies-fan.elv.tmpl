# --- Prerequisites ---
# Elvish requires you to explicitly import the regular expression module

use re
use github.com/crinklywrappr/rivendell/fun f
use github.com/crinklywrappr/rivendell/lazy l

# --- Aliases converted to Functions ---
# Elvish uses {|@a| ... } to accept and forward any number of extra arguments
fn kadmin  { kadmin -k -t {{ .keytab }} -p {{ .krb5_admin }} }
fn lvon    { hueadm group 1 on }
fn lvoff   { hueadm group 1 off }
fn bdon    { hueadm group 2 on }
fn bdoff   { hueadm group 2 off }
fn gron    { hueadm group 5 on }
fn groff   { hueadm group 5 off }
fn ftincus { ssh -t {{ .container_hostname_full }} -- sudo systemctl restart incus }
fn rd      { set_scene "{{ .scene_1_rd }}" 1 }
fn rdbr    { set_scene "{{ .scene_2_rd }}" 2 }
fn rr      { set_scene "{{ .scene_1_rr }}" 1 }
fn rrn     { set_scene "{{ .scene_1_rrn }}" 1 }

# --- Custom String Manipulation Function ---
fn incustohost {|arg|
    # re:replace handles regex replacement. It accepts (pattern, replacement, source)
    var val = (re:replace '.*-replicated$' '' $arg)
    echo (re:replace '.*:.*-' '' $val)
}

# --- Aliases dependent on functions ---
fn incuslst { incusls {{ .container_hostname }} | f:listify }

fn inc-to-list {|hosts| each {|h| put (incustohost $h)"{{ .domain }}"} $hosts | f:listify} 

var u = "{{ .update_command }}"
fn update-containers {
  var hosts = (inc-to-list (incuslst))

  peach &num-workers=4 {|h| ssh -t $h -- $u } $hosts
}

